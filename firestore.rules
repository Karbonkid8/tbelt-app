rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function belongsToSite(siteId) {
      return signedIn() && request.auth.token.siteId == siteId;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{userId} {
      allow read, write: if isAdmin();
    }

    match /sites/{siteId} {
      allow read: if belongsToSite(siteId) || isAdmin();
      allow create, update, delete: if isAdmin();

      match /containers/{containerId} {
        allow read: if belongsToSite(siteId) || isAdmin();
        allow create, update: if belongsToSite(siteId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /requisitions/{requisitionId} {
        allow read: if belongsToSite(siteId) || isAdmin();
        allow create: if belongsToSite(siteId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /pumpingPrograms/{programId} {
        allow read, create, update: if belongsToSite(siteId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /wells/{wellId} {
        allow read: if belongsToSite(siteId) || isAdmin();
        allow create, update, delete: if isAdmin();
      }

      match /cngTrailers/{trailerId} {
        allow read, create, update: if belongsToSite(siteId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /cngReadings/{readingId} {
        allow read, create: if belongsToSite(siteId) || isAdmin();
        allow update, delete: if isAdmin();
      }

      match /cngStages/{stageId} {
        allow read, create, update: if belongsToSite(siteId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /accessLog/{entryId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }
  }
}
